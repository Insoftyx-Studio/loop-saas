# Copy this to `setup.env` and fill in the values from your Supabase dashboard.
# setup.env stays on YOUR machine. It is git-ignored. Never share these values.

# 1) Personal access token — https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# 2) Project ref — the <ref> in app.supabase.com/project/<ref>
SUPABASE_PROJECT_REF=

# 3) Database password — the one you set when creating the project
SUPABASE_DB_PASSWORD=

# 4) Project URL — Project Settings -> API -> Project URL
SUPABASE_URL=

# 5) Service role key — Project Settings -> API (server-only, full admin)
SUPABASE_SERVICE_ROLE_KEY=

# 6) OPTIONAL — Connection string (URI) from Project Settings -> Database.
#    If provided (and psql is installed), the script auto-runs the data seed.
#    If left blank, the script tells you to paste supabase/seed.sql into the
#    dashboard SQL Editor instead.
SUPABASE_DB_URL=
